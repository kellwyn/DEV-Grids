# ─── GridReid Bot — Environment Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored. Passwords/credentials go in keyring — never here.

# ── MT5 Connection (non-sensitive params) ─────────────────────────────────────
MT5_PATH=
MT5_LOGIN=
MT5_SERVER=
# MT5_PASSWORD — use keyring, never .env:
#   python -c "import keyring; keyring.set_password('mt5', 'default_password', 'YOUR_PW')"

# ── Instrument ────────────────────────────────────────────────────────────────
SYMBOL=US30
TIMEFRAME=M5

# ── Grid Configuration ────────────────────────────────────────────────────────
GRID_STEP=50
MAJOR_STEP=1000
MID_STEP=250
TOLERANCE=15

# ── Direction Bias ────────────────────────────────────────────────────────────
# Set manually at start of session. Change via REPL during the day.
BIAS=LONG
EXPECTED_MOVE=350

# ── Trade Management ──────────────────────────────────────────────────────────
MAX_TRADES=5
TP_PIPS=50
SL_PIPS=0
MIN_RR=0

# ── Risk Management ───────────────────────────────────────────────────────────
RISK_PERCENT=1.0
MAX_LOTS=5.0
FIXED_LOTS=0

# ── Loss Limits ───────────────────────────────────────────────────────────────
LOSS_LIMIT_PCT=5.0
LOSS_LIMIT_USD=0
EXIT_LEVEL=0

# ── Execution Mode ────────────────────────────────────────────────────────────
MANUAL_CONFIRM=true
SCAN_INTERVAL=30

# ── Period / Session Filters ──────────────────────────────────────────────────
USE_PERIOD_FILTER=false
ALLOWED_PERIODS=
USE_SESSION_FILTER=false
TRADE_ASIAN=false
TRADE_LONDON=true
TRADE_NY=true

# ── EA Settings ───────────────────────────────────────────────────────────────
MAGIC_NUMBER=20260426
SLIPPAGE=20

# ── Broker Profiles ───────────────────────────────────────────────────────────
# Profile format: PROFILE_<NAME>_<VAR>
# Usage: python main.py --profile metaquotes

PROFILE_METAQUOTES_SYMBOL=US30
PROFILE_METAQUOTES_MT5_LOGIN=
PROFILE_METAQUOTES_MT5_SERVER=MetaQuotes-Demo

PROFILE_BLACKBULL_SYMBOL=US30.f
PROFILE_BLACKBULL_MT5_LOGIN=
PROFILE_BLACKBULL_MT5_SERVER=BlackBull-Live
